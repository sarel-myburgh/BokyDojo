# =============================================================================
# BokyDojo — Caddyfile
# TODO 0.2.3 — automatic HTTPS
# =============================================================================

# Replace {$DOMAIN} with your domain in .env, or set it directly here.
# Caddy handles TLS certificate provisioning automatically via Let's Encrypt.

{$DOMAIN:localhost} {
    # Proxy to the Django app
    reverse_proxy web:8000 {
        header_up X-Forwarded-Proto {scheme}
        header_up X-Real-IP {remote_host}
    }

    # Serve static files directly
    handle /static/* {
        root * /app/staticfiles

        # ⚠ Without this, file_server sends only Last-Modified and ETag, and a
        # browser with no explicit freshness applies *heuristic* caching — it
        # invents a lifetime from the file's age and serves the old asset for
        # it. Django writes static files under stable, unhashed names, so a
        # redeploy does not change any URL and nothing else busts them. That is
        # how a shipped fix could sit invisible in somebody's browser.
        #
        # "no-cache" does not mean "do not cache": it means revalidate every
        # time. The ETag still turns almost every one of those into a 304, so
        # this costs a round trip, not the file.
        header Cache-Control "no-cache"
        file_server
    }

    # ⚠ There is deliberately NO /media/* file_server here, and adding one back
    # is a data breach rather than an optimisation.
    #
    # Everything under MEDIA_ROOT is uploaded personal data: consent documents,
    # signed waivers, medical attachments and photographs of children. Django
    # serves all of it through permission-checked, audited views
    # (document_download_view, student_photo_view) which enforce role, dojo
    # scope and — for photographs — current consent.
    #
    # A file_server on this path bypasses every one of those. It would mean that
    # anyone holding a document's UUID, which travels in browser history,
    # referrer headers, server logs and shared links, could fetch the file
    # unauthenticated and for ever — including after consent was revoked or the
    # member left. That makes the 1.1.14 claim "revocation immediately blocks
    # direct document reads" untrue.
    #
    # If Django proves too slow at serving files, the answer is an internal
    # redirect (Caddy `handle` + `internal`, or X-Accel-Redirect) where the app
    # still authorises every request — not a public root.

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output stdout
        format json
    }
}
