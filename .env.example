# =============================================================================
# DojoMaster Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# All variables here are read by config/settings/base.py (and dev/prod variants).
# =============================================================================

# -- Django core ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key-at-least-50-characters-long
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -- Database (PostgreSQL) -----------------------------------------------------
POSTGRES_DB=dojomaster
POSTGRES_USER=dojomaster
POSTGRES_PASSWORD=dojomaster
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -- Redis (for Celery background jobs) ----------------------------------------
REDIS_URL=redis://redis:6379/0

# -- Celery --------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -- Email (SMTP — external provider required for production) -------------------
# Self-hosters: use a transactional SMTP service (Mailgun, SendGrid, etc.)
# Residential IPs land in spam. Do NOT use local MTA in production.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@example.com

# -- ABA PayWay (Phase 2) -----------------------------------------------------
# PAYWAY_MERCHANT_ID=
# PAYWAY_API_KEY=
# PAYWAY_SECRET_KEY=
# PAYWAY_BASE_URL=https://paywingate.com

# -- File storage --------------------------------------------------------------
# Default: local volume at /app/media. Set for S3-compatible storage.
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -- Backup (Phase 5) ----------------------------------------------------------
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=
# BACKUP_ENCRYPTION_KEY=
