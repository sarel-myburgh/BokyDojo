# =============================================================================
# BokyDojo Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# All variables here are read by config/settings/base.py (and dev/prod variants).
# =============================================================================

# -- Django core ---------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key-at-least-50-characters-long
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Generate a separate one-time value; required in production for /setup/.
DJANGO_FIRST_RUN_TOKEN=change-me-to-a-one-time-setup-token
# Generate with: python -c "import base64,os;print('1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
DJANGO_FIELD_ENCRYPTION_KEYS=change-me-to-a-generated-key
DJANGO_DEFAULT_FROM_EMAIL=BokyDojo <noreply@example.com>

# Two-step verification. ⚠ Leave this false unless you mean it.
#
# false — the shipped behaviour: enrolment is encouraged with a banner and never
#   required. Anyone who has enrolled is still always challenged at sign-in.
# true  — privileged roles (organisation and dojo administrators, and anyone who
#   can see financials or export personal data) cannot use the app until they
#   have enrolled an authenticator app.
#
# ⚠ Turning this on locks out an administrator whose phone is lost, and these
# deployments often have no working SMTP to send a reset. It was set to true by
# hand on at least one deployment and then forgotten, which surfaced as "MFA is
# still compulsory" long after the default had changed.
DJANGO_MFA_ENFORCEMENT=false

# -- Database (PostgreSQL) -----------------------------------------------------
POSTGRES_DB=bokydojo
POSTGRES_USER=bokydojo
POSTGRES_PASSWORD=bokydojo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# -- Redis (for Celery background jobs) ----------------------------------------
REDIS_URL=redis://redis:6379/0

# -- Celery --------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# -- Email (SMTP — external provider required for production) -------------------
# Self-hosters: use a transactional SMTP service (Mailgun, SendGrid, etc.)
# Residential IPs land in spam. Do NOT use local MTA in production.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# -- ABA PayWay (Phase 2) -----------------------------------------------------
# PAYWAY_MERCHANT_ID=
# PAYWAY_API_KEY=
# PAYWAY_SECRET_KEY=
# PAYWAY_BASE_URL=https://paywingate.com

# -- File storage --------------------------------------------------------------
# Default: local volume at /app/media. Set for S3-compatible storage.
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# -- Backup (Phase 5) ----------------------------------------------------------
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=
# BACKUP_ENCRYPTION_KEY=
